# Copy to .env.local. Never use the VITE_ prefix (that exposes values in the browser).

# Staff Insights PIN — server-only. Do not ship this to the client.
ADMIN_PIN=

# --- Registration OTP email (server-only) ---
# Option A — any SMTP account (e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=you@gmail.com, SMTP_PASS=<16-char Gmail App Password from
#   https://myaccount.google.com/apppasswords — requires 2-step verification>).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B — Resend (free tier, https://resend.com): takes priority over SMTP if set.
RESEND_API_KEY=
# Optional pretty sender, e.g. "AYURDISHA <no-reply@yourdomain.com>"
MAIL_FROM=
# Signs the pending-OTP httpOnly cookie so verify works across Vercel
# serverless instances (no shared disk). Falls back to ADMIN_PIN if unset.
OTP_COOKIE_SECRET=
# If neither is set, OTPs are printed to the SERVER console only (dev fallback);
# they are never returned to the browser.

# --- Firestore (production store — priority 1 when set) ---
# Server-only Admin SDK credentials. Clients NEVER use these; see firestore.rules (deny all).
# Setup: https://console.firebase.google.com → new project → Firestore → service account key.
# On Vercel: add all three below to Production (and Preview if needed). Redeploy after setting.
# Verify: POST /api/aym-store {"op":"ping"} → "backend":"firestore"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste PEM with \n escapes, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Alternatives (pick one approach — do not commit real values):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Local dev: drop JSON as serviceAccount.json or *firebase-adminsdk*.json in this folder (gitignored).

# --- Gemini AI (Knowledge journal search — server-only) ---
# Create at https://aistudio.google.com/apikey
# Vercel: Project → Settings → Environment Variables → GEMINI_API_KEY → Production → Redeploy
# Without this key, search uses query-matched fallback sources (PubMed, WHO, Ayush, etc.)
GEMINI_API_KEY=

# --- Vercel Blob (fallback store — priority 2) ---
# Used when Firebase creds are absent. Production today: ayurdisha/live-store.json
# Migrate to Firestore: node scripts/migrate-blob-to-firestore.js (see docs/DATA-STORAGE.md)
BLOB_READ_WRITE_TOKEN=
